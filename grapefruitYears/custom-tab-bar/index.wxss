.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #ececee;
  display: flex;
  align-items: center;
  z-index: 100;
}
.tab {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
}
.icon {
  font-size: 44rpx;
  line-height: 52rpx;
  filter: grayscale(1);
  opacity: 0.5;
}
.label {
  font-size: 18rpx;
  color: #9aa0a6;
  margin-top: 2rpx;
}
.tab.on .icon {
  filter: none;
  opacity: 1;
}
.tab.on .label {
  color: #007aff;
  font-weight: 600;
}
.tab.center .icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -34rpx;
  font-size: 46rpx;
}
.tab.center .label {
  margin-top: 4rpx;
}
.dot {
  position: absolute;
  top: 10rpx;
  right: 24rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
}
