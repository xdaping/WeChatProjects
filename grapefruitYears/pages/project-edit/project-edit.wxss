/* pages/project-edit/project-edit.wxss */
.nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back {
  font-size: 48rpx;
  color: var(--text);
  width: 60rpx;
}
.title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
  font-size: 34rpx;
  font-weight: 700;
}
.nav-pad {
  width: 60rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}
.save-btn {
  background: var(--brand);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 700;
}

.preview {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.pv-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 22rpx;
}
.pv-name {
  font-size: 34rpx;
  font-weight: 700;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-2);
}
.input.right {
  max-width: 200rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.cell {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #f4f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  border: 3rpx solid transparent;
}
.cell.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.colors {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.color {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: 4rpx solid transparent;
  box-sizing: content-box;
}
.color.on {
  border-color: #17181a33;
  transform: scale(1.08);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}
.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: var(--text-2);
  font-size: 26rpx;
}
.chip.on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.picker-val {
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 600;
}

.danger {
  text-align: center;
  color: #ff3b30;
  font-weight: 600;
  font-size: 30rpx;
  padding: 32rpx;
}
